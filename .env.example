# Plantilla de variables de entorno de CellFix.
# Copia este archivo como .env.local y completa los valores.
# Se sube a git: nunca pongas valores reales aquí.

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=cellfix
# true para bases de datos en la nube que exigen SSL
DB_SSL=false

# ─── Resend (correos) — https://resend.com/api-keys ───────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Para pruebas usa onboarding@resend.dev; en producción, un dominio verificado.
RESEND_FROM_EMAIL="CellFix <onboarding@resend.dev>"

# Correo que recibe las solicitudes del formulario del landing
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# ─── Administrador de la plataforma ───────────────────────────
# Solo los usa: npm run admin:create
# Después de crearlo puedes borrar ADMIN_PASSWORD de tu .env.local.
ADMIN_EMAIL=adminpanel@cellfix.com
ADMIN_PASSWORD=cambia_esta_contraseña
ADMIN_NAME=Administrador

# ─── Evidencia fotográfica ────────────────────────────────────
# URL con la que el celular abre el enlace del código QR. En desarrollo usa la IP de tu
# computadora en la red local (p. ej. http://192.168.1.50:3000). Vacío: se usa la del navegador.
APP_URL=
# Carpeta (en disco persistente) donde se guardan las fotos. Vacío: storage/uploads
UPLOADS_DIR=
