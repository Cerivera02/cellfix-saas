# Plantilla de variables de entorno de CellFix.
# Copia este archivo como .env.local y completa los valores.
# Se sube a git: nunca pongas valores reales aquí.

# ─── PostgreSQL ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_NAME=cellfix
# true para bases de datos en la nube que exigen SSL
DB_SSL=false

# ─── Resend (correos) — https://resend.com/api-keys ───────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Para pruebas usa onboarding@resend.dev; en producción, un dominio verificado.
RESEND_FROM_EMAIL="CellFix <onboarding@resend.dev>"

# Correo que recibe las solicitudes del formulario del landing
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# ─── Administrador de la plataforma ───────────────────────────
# Solo los usa: npm run admin:create
# Después de crearlo puedes borrar ADMIN_PASSWORD de tu .env.local.
ADMIN_EMAIL=adminpanel@cellfix.com
ADMIN_PASSWORD=cambia_esta_contraseña
ADMIN_NAME=Administrador

# ─── Evidencia fotográfica ────────────────────────────────────
# URL pública de la app. OBLIGATORIA EN PRODUCCIÓN (p. ej. https://app.cellfix.mx): con ella se
# arman las direcciones de regreso de Stripe y los enlaces de los correos; sin ella, en producción
# los pagos se niegan en vez de confiar en encabezados de la petición.
# También es la URL con la que el celular abre el enlace del código QR. En desarrollo usa la IP de tu
# computadora en la red local (p. ej. http://192.168.1.50:3000). Vacío (solo desarrollo): la del navegador.
APP_URL=
# Carpeta (en disco persistente) donde se guardan las fotos. Vacío: storage/uploads
UPLOADS_DIR=

# ─── Stripe (suscripciones) — https://dashboard.stripe.com/test/apikeys ─
# Usa las llaves de MODO DE PRUEBA (sk_test_…) mientras desarrollas; en producción, las live.
# Sin STRIPE_SECRET_KEY la página de suscripción avisa que los pagos no están configurados.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Secreto con el que se verifica la firma del webhook (/api/stripe/webhook).
# En local: instala la Stripe CLI y ejecuta (en una sola línea)
#   stripe login
#   stripe listen --forward-to localhost:3000/api/stripe/webhook --events checkout.session.completed,checkout.session.async_payment_succeeded,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed,invoice.finalized,invoice.paid,invoice.payment_failed,invoice.voided,invoice.marked_uncollectible
# y copia aquí el whsec_… que imprime.
# En producción crea el endpoint https://TU_DOMINIO/api/stripe/webhook en Developers → Webhooks
# con estos eventos y usa su "Signing secret":
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
#   customer.subscription.paused, customer.subscription.resumed,
#   invoice.finalized, invoice.paid, invoice.payment_failed, invoice.voided, invoice.marked_uncollectible
# Tarjeta de prueba: 4242 4242 4242 4242, cualquier fecha futura y cualquier CVC.
# El botón "Administrar pago" usa el portal de clientes: actívalo una vez en
# Settings → Billing → Customer portal (en modo de prueba y en live).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
#
# Cómo probar cobros recurrentes (solo en modo de prueba):
# - Relojes de prueba: en Dashboard → Billing → Test clocks crea un reloj y un cliente ligado a él,
#   pon su id (cus_…) en tenants.stripe_customer_id del taller de prueba y paga desde /dashboard/suscripcion.
#   Luego adelanta el tiempo en el Dashboard o con
#     stripe test_helpers test_clocks advance clock_xxx --frozen-time <unix_timestamp>
#   para ver el fin de la prueba, la renovación mensual y los reintentos.
# - Cobro fallido: paga con la tarjeta 4000 0000 0000 0341 (se guarda, pero falla al cobrar) y adelanta
#   el reloj, o simula el evento con: stripe trigger invoice.payment_failed
#   (el evento simulado crea su propio cliente, así que solo prueba que el webhook responde).
# - Los eventos de prueba se rechazan si la llave es live, y al revés.

# ─── Límites de solicitudes (registro, inicio de sesión, POST en general) ─
# Cuántos proxies de confianza (balanceador, CDN) hay delante de la app. Para todos los límites
# por IP se toma la IP que está ese número de saltos desde la DERECHA de X-Forwarded-For.
# 1 = un proxy (lo común en hosting). 0 = sin proxy: se ignora X-Forwarded-For.
# IMPORTANTE: si pones más saltos de los que hay en verdad, el cliente puede inventar su IP con
# X-Forwarded-For y saltarse los límites; si pones menos, todos comparten la IP del proxy.
TRUST_PROXY_HOPS=1
# Opcionales (por omisión 120): POST/PUT/PATCH/DELETE por IP y por minuto que deja pasar el proxy,
# en general y para las subidas de fotos (/api/evidencia). El webhook de Stripe nunca se limita.
# Los demás límites (inicio de sesión, registro, landing) están en src/lib/rate-limit/limits.ts.
# RATE_LIMIT_POST_PER_MINUTE=120
# RATE_LIMIT_EVIDENCE_PER_MINUTE=120
# Los contadores viven en la memoria de cada proceso (y el proxy tiene los suyos). Con varias
# instancias en producción cada una cuenta aparte: cambia el almacén por Redis o Postgres
# (ver src/lib/rate-limit/store.ts).
